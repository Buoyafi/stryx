{
  "name": "stryx",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Stryx: multi-chain EVM automation platform (NFT intelligence, wallet intelligence, blockchain automation).",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "packages/blockchain/*",
    "packages/security/*",
    "workers/*"
  ],
  "scripts": {
    "build": "node scripts/build-workspaces.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "dev:infra": "docker compose -f infra/docker/docker-compose.yml up -d",
    "dev:infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "chains:doctor": "npm run chains:doctor -w @stryx/api --"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "globals": "^15.15.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=20"
  }
}
