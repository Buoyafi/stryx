# ---- Copy this file to .env and fill in values. NEVER commit the real .env. ----
# Variable names here match exactly what the code reads (packages/config/src/index.ts).
# Anything not listed here is not read by the app.

NODE_ENV=development
PORT=3000

# Required. The operator token: the API refuses to start without it, and the dashboard's token
# login asks for it. Make one with `openssl rand -hex 32`.
API_AUTH_TOKEN=

# POST /wallets/import accepts a raw private key in the request body: over
# plain HTTP that key is readable in transit. Required to be explicitly
# "true" once NODE_ENV=production (the app refuses to start otherwise); this
# process cannot verify TLS termination for itself, so it's a deliberate
# operator declaration, not auto-detected. Irrelevant in development.
TLS_TERMINATED=false

# ---- Database ----
# The migration-owning role. `prisma migrate`/`prisma studio` use this.
DATABASE_URL=postgresql://stryx:stryx_dev_only@localhost:5432/stryx
# ADR-002 §3.10: the app's RUNTIME connection, as the lower-privileged
# "stryx_app" role (provisioned by the provision_app_role migration) that
# cannot UPDATE/DELETE audit_log. Optional: falls back to DATABASE_URL if
# unset, but then audit-log tamper-resistance is NOT actually enforced,
# server.ts warns loudly when that happens.
RUNTIME_DATABASE_URL=postgresql://stryx_app:stryx_app_dev_only@localhost:5432/stryx
# The operator Overview's queries run as this read-only role when set (it cannot write, and cannot
# read password hashes or wallet keys). Change its password on a real database, as for stryx_app.
ANALYTICS_DATABASE_URL=postgresql://stryx_analytics:stryx_analytics_dev_only@localhost:5432/stryx

# ---- Redis (nonce manager, emergency-stop flags, BullMQ scheduler) ----
REDIS_URL=redis://localhost:6379

# ---- KMS / key custody (see docs/adr/ADR-001) ----
# local  = in-memory dev provider (NEVER for production)
# aws    = AWS KMS (requires KMS_KEY_ID + real AWS credentials in the environment)
KMS_PROVIDER=local
KMS_KEY_ID=
# Required with KMS_PROVIDER=local: a stable 32-byte hex key. Make one with `openssl rand -hex 32`
# and keep it: wallets encrypted under it cannot be read with any other.
LOCAL_KMS_KEK=

# ---- RPC endpoints (one per chain) ----
# Each is OPTIONAL. A chain becomes usable for minting only when its RPC is set.
# Free public endpoints work for testing; use a dedicated provider
# (Alchemy/QuickNode/Chainstack) for anything time-sensitive or production.
RPC_ROBINHOOD_PRIMARY=https://rpc.mainnet.chain.robinhood.com
# Testnets are switched off in production unless ENABLE_TESTNETS=true (unset: on in development,
# off in production). Uncomment to test on Robinhood Chain Testnet again.
# ENABLE_TESTNETS=true
# RPC_ROBINHOOD_TESTNET=https://rpc.testnet.chain.robinhood.com
# Optional second endpoint per Robinhood chain: reads and broadcasts fall back to this on a
# transport-level failure (timeout, connection failure, 429/5xx) from the primary above. A
# chain with only its fallback set (primary left blank) still works, using the fallback as
# its sole endpoint.
RPC_ROBINHOOD_FALLBACK=
RPC_ROBINHOOD_TESTNET_FALLBACK=
# Other chains: the main endpoint is RPC_<CHAIN> (no _PRIMARY suffix), and RPC_<CHAIN>_FALLBACK
# is an optional second provider, used the same way as the Robinhood fallback above. For a chain
# you mint on under time pressure, set the fallback from a DIFFERENT provider than the main one.
# A misspelled name (e.g. RPC_ETHEREUM_PRIMARY) is ignored and logged as a warning at startup.
RPC_ETHEREUM=
RPC_ETHEREUM_FALLBACK=
RPC_BASE=
RPC_BASE_FALLBACK=
RPC_ARBITRUM=
RPC_ARBITRUM_FALLBACK=
RPC_OPTIMISM=
RPC_OPTIMISM_FALLBACK=
RPC_POLYGON=
RPC_POLYGON_FALLBACK=
RPC_BNB=
RPC_BNB_FALLBACK=
RPC_HYPEREVM=
RPC_HYPEREVM_FALLBACK=
RPC_BERACHAIN=
RPC_BERACHAIN_FALLBACK=
RPC_MONAD=
RPC_MONAD_FALLBACK=
RPC_AVALANCHE=
RPC_AVALANCHE_FALLBACK=
RPC_ABSTRACT=
RPC_ABSTRACT_FALLBACK=
RPC_INK=
RPC_INK_FALLBACK=
RPC_RONIN=
RPC_RONIN_FALLBACK=
RPC_ARC=
RPC_ARC_FALLBACK=

# ---- OpenSea (drop resolver: URL/slug -> contract) ----
# Optional. Only needed to resolve collection slugs; asset URLs work without it.
OPENSEA_API_KEY=

# Eligibility checks for signed allow-list stages. They need an optional module that is not
# part of this repository; without it this setting does nothing. Leave it false.
OPENSEA_SIGNED_MINT_ELIGIBILITY_ENABLED=false

# ---- Signed-mint execution (GTD/FCFS stages) ----
# The kill switch. false = nothing on a signed stage can be scheduled or fired, and a run that
# has not broadcast yet stops at its next check (needs an API restart to take effect; for an
# instant stop with no restart, use the emergency stop). Only documented OpenSea endpoints are
# used: GET /api/v2/drops/{slug} and POST /api/v2/drops/{slug}/mint.
SIGNED_MINT_EXECUTION_ENABLED=false

# The API refuses to start when the database is missing a migration this build ships with, and
# says which ones and how to apply them. Set true only to start anyway (e.g. debugging a migration).
# ALLOW_PENDING_MIGRATIONS=false

# What API_AUTH_TOKEN may do: admin (everything; the default in development), api (acts as the
# operator for scripts but never passes an admin check), off (not accepted; the default in
# production, where the operator signs in with a wallet).
# OPERATOR_TOKEN_MODE=admin
# Tuning (defaults shown): retry interval while OpenSea says "not active", how long after the
# stage opens to keep trying, and how many OpenSea mint requests may be in flight at once.
SIGNED_MINT_RETRY_INTERVAL_MS=250
SIGNED_MINT_GIVE_UP_MS=60000
SIGNED_MINT_OPENSEA_CONCURRENCY=4
# Speed. Around the stage opening each wallet sends a new request every OVERLAP_MS without waiting
# for the last answer, up to MAX_IN_FLIGHT at once (0 or 1 turns it off). The cap above is shared by
# the whole job: raise it when several wallets should each overlap. A rate limit from OpenSea
# switches the job back to one request at a time.
SIGNED_MINT_OVERLAP_MS=200
SIGNED_MINT_MAX_IN_FLIGHT=3
# Unlock each wallet's key at warm-up and hold it in memory until the wallet has sent, saving one
# KMS round trip at the moment of signing. Off by default: while held, the key can be read from
# this process's memory.
SIGNED_MINT_HOLD_KEYS=false
# With a primary and a fallback RPC set for a chain, send each signed transaction to both at once.
RPC_RACE_BROADCAST=true

# ---- Prices (optional) ----
# A free CoinGecko demo key lifts the keyless rate limit on USD prices. Blank works, with limits.
COINGECKO_API_KEY=

# ---- Daily spend caps (ADR-002 §3.7) ----
# Caps apply to signed-up accounts; the operator account is unlimited. Each chain has its own
# daily budget in its own token. Chains that pay gas in ETH use DEFAULT_DAILY_SPEND_CAP_WEI
# (wei; blank = 1 ETH). Other chains use DEFAULT_DAILY_SPEND_CAPS, "chainId=amount" in that
# chain's token; a chain not listed there is 0, so a capped account sends nothing on it.
DEFAULT_DAILY_SPEND_CAP_WEI=
DEFAULT_DAILY_SPEND_CAPS=
# Per-wallet caps: the share (percent) of the account's daily cap on a chain that any one of its
# wallets may spend that day, so no single wallet can use up the account's whole day. 1 to 100;
# blank = 50. 100 turns the separate wallet limit off.
WALLET_DAILY_SPEND_SHARE_PERCENT=

# Wallet sign-in and invite codes (ADR-003). Setting APP_ORIGIN turns them on.
# The dashboard's exact origin, no path. Must be https in production.
# Several, comma-separated, if you open the dashboard at more than one address. Locally, the dev
# server (5173) and `npx vite preview` (4173): without the second, the preview's writes are refused
# ("This request did not come from the Stryx app"). In production, list only your real domain.
# APP_ORIGIN=http://localhost:5173,http://localhost:4173
# At least 32 random characters, e.g. `openssl rand -hex 32`. Required with APP_ORIGIN.
# ACCESS_CODE_SECRET=
# Only behind a reverse proxy you control, so per-IP limits see real visitors.
# TRUST_PROXY=false   (or the number of proxies you control in front of the API: true or 1 for one, 2 for two)
# Terms acceptance (docs/legal). Set BOTH to the versions users must have accepted, e.g. "1.0". Set: a new
# account has to tick the box to sign up, and an account that has not accepted the current versions
# cannot mint, schedule or create wallets until it does (it can still browse, cancel, export keys and move
# its own assets out). Unset (default): nothing is asked or enforced. Changing a version asks everyone again.
# Turn on only once the Terms and Privacy Policy are final (see docs/legal/*-REVIEW.md).
# TERMS_VERSION=1.0
# PRIVACY_VERSION=1.0

# Waitlist invites by email (Admin -> Waitlist -> "Approve & send invite"): makes the person a
# 14-day invite code and emails it, through Resend (resend.com). Needs APP_ORIGIN too. Unset: the
# button is not shown, and invites stay manual. The sender must be on a domain verified in Resend.
RESEND_API_KEY=
# INVITE_EMAIL_FROM=Stryx <invites@gostryx.com>
# Where replies go. Unset: to the sender address.
# INVITE_EMAIL_REPLY_TO=hello@gostryx.com
# The landing page the email links to. Unset: APP_ORIGIN without a leading "app.".
# SITE_URL=https://gostryx.com

# Dashboard (apps/dashboard, read at build time): where "Join the waitlist" on the Home
# welcome card goes, e.g. the landing page's #waitlist. Unset: the button is not shown.
# VITE_WAITLIST_URL=https://stryx.example/#waitlist
# Landing page (apps/landing, read at build time): where "Sign in" and "Already have an access code?"
# go, i.e. the dashboard's address. Unset in a production build: those links are not shown. In
# development it defaults to http://localhost:5173. https only (http allowed on localhost).
# VITE_APP_URL=https://app.stryx.example
# Landing page: show the Terms and Privacy links in its footer and under the waitlist form. Off in a
# production build until true, so a draft with blanks in it is never linked. Shown in development.
# VITE_LEGAL_LINKS=true
# Landing page: where its live-drops strip finds the API when /api is not proxied on the same host.
# VITE_API_URL=https://api.stryx.example
# The "Operator? Use the API token" link on the sign-in card shows in development only. Set this to
# show it in a deployed build too. /login/token works by URL either way.
# VITE_SHOW_OPERATOR_LOGIN=true
# Where the published Terms of Use and Privacy Policy are (the landing page's /terms.html and /privacy.html),
# linked from the sign-up checkbox. Unset: the names show as plain text.
# VITE_TERMS_URL=https://stryx.example/terms.html
# VITE_PRIVACY_URL=https://stryx.example/privacy.html
# WalletConnect (Reown) project ID, from dashboard.reown.com: adds "Phone wallet" (scan a QR code with
# MetaMask, Rainbow, Trust and others on a phone) to the Connect wallet chooser. Public, it ships in the
# page. Add each origin that serves the dashboard (localhost:5173, the real domain) under the project's
# allowed domains in Reown. Unset: the option is not shown.
# VITE_WALLETCONNECT_PROJECT_ID=
